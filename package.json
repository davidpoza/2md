{
  "name": "2md",
  "version": "0.2.0",
  "description": "Conversor local de PDF y DOCX a Markdown",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "electron .",
    "mcp": "node app/mcp-entry.js",
    "test": "node --test tests-node/*.test.js",
    "dist": "electron-builder --win dir --x64",
    "dist:mcp": "electron-builder --win dir --x64 --config.afterPack=.\\scripts\\after-pack.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.3",
    "@napi-rs/keyring": "1.2.0",
    "@xberg-io/xberg": "1.3.10",
    "https-proxy-agent": "7.0.6",
    "mermaid": "11.12.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.2md.desktop",
    "productName": "2MD",
    "asar": false,
    "npmRebuild": false,
    "files": ["app/**/*", "package.json"],
    "win": {
      "target": "dir",
      "executableName": "2MD",
      "signAndEditExecutable": false
    }
  }
}
